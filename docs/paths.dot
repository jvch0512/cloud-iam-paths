digraph iam {
  rankdir=LR;
  node [shape=box, fontname="Helvetica"];
  "ADMIN" [style=filled, fillcolor="#f8d7da", fontcolor="#000000"];
  "admin-role" [style=filled, fillcolor="#f8d7da", fontcolor="#000000"];
